{
  "name": "xr-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first collector for YouTube transcripts",
  "main": "dist/node/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1 --port 7176 --strictPort",
    "build": "npm run typecheck && npm run build:node && npm run build:web",
    "build:node": "tsc -p tsconfig.node.json && node scripts/write-build-info.mjs --kind development",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "node dist/node/server/main.js",
    "electron": "npm run build && electron .",
    "prepare:meilisearch": "node scripts/prepare-meilisearch.mjs",
    "doctor:build": "node scripts/build-doctor.mjs",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "download:runtime": "node scripts/prepare-runtime.mjs mac",
    "package:mac": "node scripts/package-app.mjs --target darwin-arm64",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:ci": "vitest run --config vitest.config.ts --reporter=default --reporter=junit --outputFile.junit=.data/ci/junit.xml",
    "verify": "npm run test:ci && npm run build",
    "download:runtime:win": "node scripts/prepare-runtime.mjs win",
    "package:win": "node scripts/package-app.mjs --target win32-x64",
    "release:upload": "node scripts/release-upload.mjs",
    "test:verify-skill:mac": "npm run download:runtime && node .claude/skills/verify/scripts/smoke.mjs",
    "test:verify-skill:desktop:mac": "node .claude/skills/verify/scripts/smoke-desktop.mjs",
    "test:verify-skill:desktop:win": "node .claude/skills/verify/scripts/smoke-desktop.mjs",
    "test:meilisearch:mac": "npm run download:runtime && vitest run --config vitest.config.ts tests/search/meilisearch-integration.test.ts tests/search/meilisearch-leftover.test.ts tests/server/agent-access.test.ts tests/vault/vault-transfer.test.ts tests/vault/vault-exchange.test.ts tests/vault/vault-move.test.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "electron-updater": "6.8.3",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.5",
    "opencc-js": "1.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
