{
  "name": "xr-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first collector for YouTube transcripts",
  "main": "dist/node/desktop/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/transport/server/main.ts",
    "dev:web": "vite --host 127.0.0.1 --port 7176 --strictPort",
    "build": "npm run typecheck && npm run build:node && npm run build:web",
    "build:node": "node -e \"require('node:fs').rmSync('dist/node', { recursive: true, force: true })\" && node node_modules/typescript-7/bin/tsc -p tsconfig.node.json && node scripts/package/write-build-info.mjs --kind development",
    "build:web": "vite build",
    "typecheck": "node node_modules/typescript-7/bin/tsc -p tsconfig.node.json --noEmit && node node_modules/typescript-7/bin/tsc -p tsconfig.web.json --noEmit",
    "typecheck:tests": "node node_modules/typescript-7/bin/tsc -p tsconfig.tests.json",
    "start": "node dist/node/transport/server/main.js",
    "electron": "npm run build && electron .",
    "prepare:meilisearch": "node scripts/runtime/prepare-meilisearch.mjs",
    "doctor:build": "node scripts/package/build-doctor.mjs",
    "prepare:runtime": "node scripts/runtime/prepare-runtime.mjs",
    "download:runtime": "node scripts/runtime/prepare-runtime.mjs mac",
    "package:mac": "node scripts/package/package-app.mjs --target darwin-arm64",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "verify": "npm run lint && npm test && npm run typecheck:tests && npm run build",
    "download:runtime:win": "node scripts/runtime/prepare-runtime.mjs win",
    "package:win": "node scripts/package/package-app.mjs --target win32-x64",
    "release:upload": "node scripts/package/release-upload.mjs",
    "test:verify-skill": "vitest run --config .claude/skills/verify/tests/vitest.config.ts",
    "test:meilisearch:mac": "npm run download:runtime && vitest run --config vitest.config.ts --tags-filter=real-engine"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "electron-updater": "6.8.12",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "opencc-js": "1.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.6",
    "electron": "44.10.0",
    "electron-builder": "26.15.3",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jiti": "2.7.0",
    "playwright": "1.64.1",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
