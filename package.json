{
  "name": "xr-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first collector for YouTube transcripts",
  "main": "dist/node/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1 --port 7176 --strictPort",
    "build": "npm run typecheck && npm run build:node && npm run build:web",
    "build:node": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "node dist/node/server/main.js",
    "electron": "npm run build && electron .",
    "download:runtime": "node scripts/download-runtime.mjs mac",
    "package:mac": "npm run download:runtime && npm run build && electron-builder --mac --publish never",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "prepare:exchange-demo": "npm run build:node && node scripts/prepare-exchange-demo.mjs",
    "test:ci": "vitest run --config vitest.config.ts --reporter=default --reporter=junit --outputFile.junit=.data/ci/junit.xml",
    "verify": "npm run test:ci && npm run build",
    "download:runtime:win": "node scripts/download-runtime.mjs win",
    "package:win": "npm run download:runtime:win && npm run build && electron-builder --win --x64 --publish never",
    "validation": "node scripts/validation.mjs",
    "test:meilisearch:mac": "npm run download:runtime && vitest run --config vitest.config.ts tests/search/meilisearch-integration.test.ts tests/search/meilisearch-leftover.test.ts tests/server/agent-access.test.ts tests/vault/vault-transfer.test.ts tests/vault/vault-exchange.test.ts tests/vault/vault-move.test.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
