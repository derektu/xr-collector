{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src/transport/web/**/*.ts", "src/transport/web/**/*.tsx", "src/shared/**/*-types.ts",
    "src/shared/sources/source-registry.ts",
    "src/shared/subscriptions/check-interval.ts",
    "src/shared/sources/source-contract.ts",
    "src/domain/plugins/*/shared.ts"
  ]
}
