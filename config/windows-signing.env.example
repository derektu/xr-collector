# Copy to keys/windows/.env. File paths are relative to keys/windows/. Packaging does not read this file yet; Windows packages are unsigned.
# File-based Authenticode signing: supply a PFX/P12 containing the private key.
# Leave these empty when RD signs through a token, HSM, or signing service.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
# Example: WIN_CSC_LINK=company-code-signing.pfx
